# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional
# GROQ_MODEL=llama-3.3-70b-versatile

# Firebase (only needed on Vercel, or if you want to test Firestore locally).
# Create it with:  python tools/encode_firebase_key.py path/to/your-service-account.json
# Leave this out locally to use the SQLite file (emails.db) instead.
# FIREBASE_SERVICE_ACCOUNT_B64=
